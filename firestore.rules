rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['email']) &&
         (request.auth.token.email in ["saritakumari9818422028@gmail.com", "opgandhujf@gmaol.com"] ||
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email.matches('.*@akshartournament\\.com'))) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('inGameId' in data) || data.inGameId == null || (data.inGameId is string && data.inGameId.size() <= 50)) &&
             (!('inGameName' in data) || data.inGameName == null || (data.inGameName is string && data.inGameName.size() <= 50)) &&
             (!('role' in data) || data.role in ['user', 'admin']) &&
             (!('totalMatches' in data) || data.totalMatches is int) &&
             (!('totalKills' in data) || data.totalKills is int) &&
             (!('totalWins' in data) || data.totalWins is int) &&
             (!('totalPoints' in data) || data.totalPoints is int) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidTournament(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000)) &&
             (!('rules' in data) || data.rules == null || (data.rules is string && data.rules.size() <= 2000)) &&
             (!('gameTitle' in data) || (data.gameTitle is string && data.gameTitle.size() <= 50)) &&
             data.format in ['Solo', 'Duo', 'Squad'] &&
             data.map is string && data.map.size() <= 50 &&
             data.maxSlots is int && data.maxSlots > 0 && data.maxSlots <= 500 &&
             data.filledSlots is int && data.filledSlots >= 0 && data.filledSlots <= data.maxSlots &&
             (!('entryFee' in data) || (data.entryFee is int && data.entryFee >= 0)) &&
             (!('prizePool' in data) || (data.prizePool is int && data.prizePool >= 0)) &&
             (!('firstPrize' in data) || (data.firstPrize is int && data.firstPrize >= 0)) &&
             (!('secondPrize' in data) || (data.secondPrize is int && data.secondPrize >= 0)) &&
             (!('thirdPrize' in data) || (data.thirdPrize is int && data.thirdPrize >= 0)) &&
             (!('perKillPrize' in data) || (data.perKillPrize is int && data.perKillPrize >= 0)) &&
             data.status in ['upcoming', 'live', 'completed', 'cancelled'] &&
             data.roomReleased is bool &&
             (!('winnerName' in data) || data.winnerName == null || (data.winnerName is string && data.winnerName.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('scheduledAt' in data) || data.scheduledAt is timestamp) &&
             (!('registrationEnd' in data) || data.registrationEnd is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidRegistration(data) {
      return data.id is string && data.id.size() <= 256 &&
             data.tournamentId is string && data.tournamentId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             (!('playerDisplayName' in data) || (data.playerDisplayName is string && data.playerDisplayName.size() <= 100)) &&
             data.inGameId is string && data.inGameId.size() <= 50 &&
             data.inGameName is string && data.inGameName.size() <= 50 &&
             (!('teamName' in data) || data.teamName == null || (data.teamName is string && data.teamName.size() <= 100)) &&
             (!('teammates' in data) || data.teammates == null || (data.teammates is string && data.teammates.size() <= 500)) &&
             data.status in ['confirmed', 'cancelled'] &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.content is string && data.content.size() <= 2000 &&
             (!('tag' in data) || (data.tag is string && data.tag.size() <= 30)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidLeaderboardEntry(data) {
      return data.id is string && data.id.size() <= 128 &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             data.playerName is string && data.playerName.size() <= 100 &&
             data.inGameId is string && data.inGameId.size() <= 50 &&
             (!('matchesPlayed' in data) || data.matchesPlayed is int) &&
             (!('kills' in data) || data.kills is int) &&
             (!('wins' in data) || data.wins is int) &&
             data.totalPoints is int &&
             data.rank is int &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidRoomDetails(data) {
      return data.roomId is string && data.roomId.size() <= 50 &&
             data.roomPassword is string && data.roomPassword.size() <= 50 &&
             (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidWallet(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.coins is int && data.coins >= 0 &&
             (!('totalAdded' in data) || data.totalAdded is int) &&
             (!('totalSpent' in data) || data.totalSpent is int) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidWalletTransaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.type in ['WELCOME_BONUS', 'TEST_TOPUP', 'MATCH_ENTRY', 'REFUND', 'PRIZE_PAYOUT', 'ADMIN_ADJUSTMENT'] &&
             data.amount is int &&
             (!('referenceId' in data) || data.referenceId == null || (data.referenceId is string && data.referenceId.size() <= 128)) &&
             (!('referenceTitle' in data) || data.referenceTitle == null || (data.referenceTitle is string && data.referenceTitle.size() <= 150)) &&
             data.status in ['COMPLETED', 'PENDING', 'FAILED'] &&
             data.idempotencyKey is string && data.idempotencyKey.size() <= 128 &&
             data.description is string && data.description.size() <= 500 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().userId == existing().userId &&
                       isValidUserProfile(incoming());

      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- Wallets Collection ---
    match /wallets/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidWallet(incoming());

      allow update: if isSignedIn() &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().userId == existing().userId &&
                       isValidWallet(incoming());

      // Transactions Ledger Subcollection
      match /transactions/{txId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidWalletTransaction(incoming());

        allow update, delete: if isAdmin();
      }
    }

    // --- Tournaments Collection ---
    match /tournaments/{tournamentId} {
      allow get, list: if isSignedIn();

      allow create: if (isAdmin() || isSignedIn()) && isValidTournament(incoming());

      allow update: if ((isAdmin() || isSignedIn()) && isValidTournament(incoming())) || (
        isSignedIn() &&
        resource != null &&
        isValidTournament(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['filledSlots', 'updatedAt']) &&
        incoming().filledSlots == existing().filledSlots + 1 &&
        incoming().filledSlots <= existing().maxSlots
      );

      allow delete: if isAdmin() || isSignedIn();

      // Protected Room Credentials Subcollection
      match /room/{detailId} {
        allow get, list: if isSignedIn();
        allow write: if (isAdmin() || isSignedIn()) && isValidRoomDetails(incoming());
      }
    }

    // --- Registrations Collection ---
    match /registrations/{registrationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       request.auth.uid == incoming().userId &&
                       isValidRegistration(incoming());

      allow update: if isSignedIn() &&
                       resource != null &&
                       (existing().userId == request.auth.uid || isAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().tournamentId == existing().tournamentId &&
                       isValidRegistration(incoming());

      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- Announcements Collection ---
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow write: if (isAdmin() || isSignedIn()) && isValidAnnouncement(incoming());
    }

    // --- Leaderboards Collection ---
    match /leaderboards/{leaderboardId} {
      allow get, list: if isSignedIn();
      allow write: if (isAdmin() || isSignedIn()) && isValidLeaderboardEntry(incoming());
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
